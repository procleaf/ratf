<h1>Job Runs</h1>

<table>
  <thead>
    <tr>
      <th>ID</th>
      <th>Job</th>
      <th>Status</th>
      <th>Started At</th>
      <th>Completed At</th>
      <th>Duration</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @records.each do |record| %>
      <tr>
        <td><%= record.id %></td>
        <td><%= link_to record.job&.name, job_path(record.job) if record.job %></td>
        <td><%= record.status.humanize %></td>
        <td><%= record.started_at&.strftime("%Y-%m-%d %H:%M") %></td>
        <td><%= record.completed_at&.strftime("%Y-%m-%d %H:%M") %></td>
        <td><%= record.duration ? "#{record.duration}s" : "N/A" %></td>
        <td><%= link_to "Show", job_run_path(record) %></td>
      </tr>
    <% end %>
  </tbody>
</table>
