<%= form_with(model: @record, local: true) do |f| %>
  <% if @record.errors.any? %>
    <div class="error-messages">
      <h2><%= pluralize(@record.errors.count, "error") %> prohibited this job run from being saved:</h2>
      <ul>
        <% @record.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :job_id, "Job" %>
    <%= f.collection_select :job_id, Job.order(:name), :id, :name, include_blank: true %>
  </div>

  <div class="field">
  </div>

  <div class="field">
    <%= f.label :status %>
    <%= f.select :status, JobRun.statuses.keys.map { |k| [k.humanize, k] }, include_blank: false %>
  </div>

  <div class="field">
    <%= f.label :started_at %>
    <%= f.datetime_field :started_at %>
  </div>

  <div class="field">
    <%= f.label :completed_at %>
    <%= f.datetime_field :completed_at %>
  </div>

  <div class="actions">
    <%= f.submit %>
  </div>
<% end %>
