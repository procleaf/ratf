<h1><%= @record.name %></h1>

<dl>
  <dt>ID</dt>
  <dd><%= @record.id %></dd>

  <dt>Name</dt>
  <dd><%= @record.name %></dd>

  <dt>Created At</dt>
  <dd><%= @record.created_at %></dd>

  <dt>Updated At</dt>
  <dd><%= @record.updated_at %></dd>
</dl>

<p>
  <%= link_to "Edit", edit_tag_path(@record) %> |
  <%= link_to "Back to Tags", tags_path %>
</p>
