<%= form_with(model: record, local: true) do |form| %>
  <% if record.errors.any? %>
    <div class="errors">
      <h2><%= pluralize(record.errors.count, "error") %> prohibited this tag from being saved:</h2>
      <ul>
        <% record.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
