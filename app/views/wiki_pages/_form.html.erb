<%= form_with model: @record, local: true do |f| %>
  <% if @record.errors.any? %>
    <div class="flash flash-error">
      <%= @record.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :title, "Title" %>
    <%= f.text_field :title, placeholder: "Page title" %>
  </div>

  <div class="field">
    <%= f.label :body, "Content (Markdown)" %>
    <%= f.text_area :body, rows: 20, placeholder: "Write your knowledge base article in Markdown..." %>
  </div>

  <div class="field">
    <%= f.label :tags, "Tags (comma-separated)" %>
    <%= f.text_field :tags, placeholder: "e.g. getting-started, api, troubleshooting" %>
  </div>

  <%= f.submit "Save Page", class: "btn btn-primary" %>
<% end %>
