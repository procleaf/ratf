<h1>Test Results</h1>

<%= link_to "Export CSV", export_test_results_path(format: :csv), class: "btn" %>



<table>
  <thead>
    <tr>
      <th>ID</th>
      <th>Name</th>
      <th>Status</th>
      <th>Test Case</th>
      <th>Test Suite</th>
      <th>Execution Time</th>
      <th>Created</th>
      <th colspan="3">Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @records.each do |record| %>
      <tr>
        <td><%= record.id %></td>
        <td><%= record.name %></td>
        <td><%= record.status %></td>
        <td><%= record.test_case&.name %></td>
        <td><%= record.test_suite&.name %></td>
        <td><%= record.execution_time %></td>
        <td><%= record.created_at.strftime("%Y-%m-%d %H:%M") %></td>
        <td><%= link_to "Show", test_result_path(record) %></td>
        <td></td>
        <td><%= link_to "Destroy", test_result_path(record), data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } %></td>
      </tr>
    <% end %>
  </tbody>
</table>
