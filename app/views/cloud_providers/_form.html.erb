<h1><%= @record.persisted? ? "Edit Provider" : "New Provider" %></h1>

<%= form_with(model: @record, local: true) do |f| %>
  <% if @record.errors.any? %>
    <div class="errors">
      <h2><%= pluralize(@record.errors.count, "error") %> prohibited this provider from being saved:</h2>
      <ul><% @record.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %></ul>
    </div>
  <% end %>

  <div><%= f.label :name %><%= f.text_field :name %></div>
  <div><%= f.label :provider_type %><%= f.select :provider_type, CloudProvider::PROVIDER_TYPES.map { |t| [t.upcase, t] } %></div>
  <div><%= f.label :region %><%= f.text_field :region, placeholder: "us-east-1" %></div>
  <div><%= f.label :enabled %><%= f.check_box :enabled %></div>
  <div><%= f.submit %></div>
<% end %>

<%= link_to "Back", cloud_providers_path %>
