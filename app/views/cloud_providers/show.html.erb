<h1><%= @record.display_name %></h1>

<dl>
  <dt>Name</dt><dd><%= @record.name %></dd>
  <dt>Type</dt><dd><%= @record.provider_type.upcase %></dd>
  <dt>Region</dt><dd><%= @record.region %></dd>
  <dt>Status</dt><dd><span class="badge badge-<%= @record.connected? ? 'passed' : 'pending' %>"><%= @record.status.humanize %></span></dd>
  <dt>Enabled</dt><dd><%= @record.enabled? ? "Yes" : "No" %></dd>
  <dt>Last Verified</dt><dd><%= @record.last_verified_at&.strftime("%Y-%m-%d %H:%M") || "Never" %></dd>
  <dt>Est. Monthly Cost</dt><dd>$<%= sprintf("%.2f", @record.monthly_estimated_cost) %></dd>
  <dt>Active Instances</dt><dd><%= @record.active_instances.count %></dd>
  <dt>Created</dt><dd><%= l @record.created_at, format: :long %></dd>
</dl>

<div class="flex mt-2">
  <%= button_to "Verify Connection", verify_cloud_provider_path(@record), method: :post, class: "btn btn-primary" %>
  <%= link_to "Edit", edit_cloud_provider_path(@record), class: "btn" %>
  <%= link_to "Back", cloud_providers_path, class: "btn" %>
</div>

<h2 class="mt-2">Instances</h2>
<% if @record.cloud_instances.any? %>
  <table>
    <tbody>
      <% @record.cloud_instances.each do |ci| %>
        <tr>
          <td><%= link_to ci.name, cloud_instance_path(ci) %></td>
          <td><%= ci.instance_type %></td>
          <td><span class="badge badge-<%= ci.running? ? 'passed' : 'pending' %>"><%= ci.display_status %></span></td>
          <td><%= ci.public_ip || "—" %></td>
          <td>$<%= sprintf("%.4f", ci.hourly_cost || 0) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="text-muted">No instances provisioned.</p>
<% end %>
