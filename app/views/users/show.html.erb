<%# ── Profile Header ── %>
<div class="profile-header">
  <div class="profile-avatar"><%= @record.username[0].upcase %></div>
  <div class="profile-info">
    <h1><%= @record.username %></h1>
    <p class="text-muted"><%= @record.email %> · <span class="badge badge-<%= @record.role %>"><%= @record.role.humanize %></span></p>
    <p class="text-muted">
      Last active: <%= @record.last_active_at ? time_ago_in_words(@record.last_active_at) + " ago" : "Never" %>
      · <%= @record.active? ? "🟢 Online" : "⚫ Offline" %>
    </p>
  </div>
</div>

<%# ── Stats Row ── %>
<div class="stats-grid mt-2">
  <div class="stat">
    <div class="stat-label">Jobs Created</div>
    <div class="stat-value"><%= @record.jobs.count %></div>
  </div>
  <div class="stat">
    <div class="stat-label">Success Rate</div>
    <% rate = @record.job_success_rate %>
    <div class="stat-value <%= rate >= 90 ? 'stat-success' : rate >= 70 ? 'stat-warning' : 'stat-danger' %>">
      <%= rate %>%
    </div>
  </div>
  <div class="stat">
    <div class="stat-label">Test Cases</div>
    <div class="stat-value"><%= @record.test_cases.count %></div>
  </div>
  <div class="stat">
    <div class="stat-label">Issues Reported</div>
    <div class="stat-value"><%= @record.reported_issues.count %></div>
  </div>
  <div class="stat">
    <div class="stat-label">Notifications</div>
    <div class="stat-value"><%= @record.notifications.count %></div>
  </div>
  <div class="stat">
    <div class="stat-label">API Tokens</div>
    <div class="stat-value"><%= @record.api_tokens.count %></div>
  </div>
</div>

<%# ── Jobs ── %>
<div class="card mt-2">
  <h2>Jobs</h2>
  <% jobs = @record.jobs.order(created_at: :desc).limit(5) %>
  <% if jobs.any? %>
    <table>
      <thead><tr><th>Name</th><th>Status</th><th>Priority</th><th>Created</th></tr></thead>
      <tbody>
        <% jobs.each do |job| %>
          <tr>
            <td><%= link_to job.name, job_path(job) %></td>
            <td><span class="badge badge-<%= job.status %>"><%= job.status.humanize %></span></td>
            <td><%= job.priority.humanize %></td>
            <td><%= job.created_at.strftime("%Y-%m-%d %H:%M") %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <% if @record.jobs.count > 5 %>
      <p class="mt-1"><%= link_to "View all #{@record.jobs.count} jobs →", jobs_path %></p>
    <% end %>
  <% else %>
    <p class="text-muted">No jobs yet.</p>
  <% end %>
</div>

<%# ── Test Cases Authored ── %>
<div class="card mt-2">
  <h2>Test Cases Authored</h2>
  <% cases = @record.test_cases.order(updated_at: :desc).limit(5) %>
  <% if cases.any? %>
    <table>
      <thead><tr><th>Name</th><th>Suite</th><th>Status</th><th>Priority</th></tr></thead>
      <tbody>
        <% cases.each do |tc| %>
          <tr>
            <td><%= link_to tc.name, test_case_path(tc) %></td>
            <td><%= tc.test_suite&.name || "—" %></td>
            <td><span class="badge badge-<%= tc.status %>"><%= tc.status.humanize %></span></td>
            <td><%= tc.priority.humanize %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="text-muted">No test cases authored.</p>
  <% end %>
</div>

<%# ── Issues Reported ── %>
<div class="card mt-2">
  <h2>Issues Reported</h2>
  <% reported = @record.reported_issues.order(created_at: :desc).limit(5) %>
  <% if reported.any? %>
    <table>
      <thead><tr><th>Title</th><th>Status</th><th>Severity</th><th>Created</th></tr></thead>
      <tbody>
        <% reported.each do |issue| %>
          <tr>
            <td><%= link_to issue.title, issue_path(issue) %></td>
            <td><span class="badge badge-<%= issue.status %>"><%= issue.status.humanize %></span></td>
            <td><span class="badge badge-<%= issue.severity %>"><%= issue.severity.humanize %></span></td>
            <td><%= issue.created_at.strftime("%Y-%m-%d") %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="text-muted">No issues reported.</p>
  <% end %>
</div>

<%# ── API Tokens ── %>
<div class="card mt-2">
  <h2>API Tokens</h2>
  <% tokens = @record.api_tokens.order(created_at: :desc).limit(5) %>
  <% if tokens.any? %>
    <table>
      <thead><tr><th>Name</th><th>Last Used</th><th>Expires</th></tr></thead>
      <tbody>
        <% tokens.each do |token| %>
          <tr>
            <td><%= link_to token.name, api_token_path(token) %></td>
            <td><%= token.last_used_at&.strftime("%Y-%m-%d %H:%M") || "Never" %></td>
            <td><%= token.expires_at&.strftime("%Y-%m-%d") || "Never" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="text-muted">No API tokens.</p>
  <% end %>
</div>

<%= link_to "Edit Profile", edit_user_path(@record), class: "btn mt-2" %>
<%= link_to "All Users", users_path, class: "btn mt-2" %>
