<h1>Users</h1>

<table>
  <thead>
    <tr>
      <th>Username</th>
      <th>Email</th>
      <th>Role</th>
      <th>Active</th>
    </tr>
  </thead>
  <tbody>
    <% @records.each do |record| %>
      <tr>
        <td><%= link_to record.username, user_path(record) %></td>
        <td><%= record.email %></td>
        <td><span class="badge badge-<%= record.role %>"><%= record.role.to_s.humanize %></span></td>
        <td><%= record.active? ? "Yes" : "No" %></td>
      </tr>
    <% end %>
  </tbody>
</table>
