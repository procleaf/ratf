<%= form_with(model: @record, local: true) do |f| %>
  <% if @record.errors.any? %>
    <div class="error-messages">
      <h2><%= pluralize(@record.errors.count, "error") %> prohibited this job artifact from being saved:</h2>
      <ul>
        <% @record.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :job_id, "Job" %>
    <%= f.collection_select :job_id, Job.order(:name), :id, :name, include_blank: true %>
  </div>

  <div class="field">
    <%= f.label :name %>
    <%= f.text_field :name %>
  </div>

  <div class="field">
    <%= f.label :artifact_type, "Type" %>
    <%= f.select :artifact_type, JobArtifact.artifact_types.keys.map { |k| [k.humanize, k] }, include_blank: false %>
  </div>

  <div class="field">
    <%= f.label :file %>
    <%= f.file_field :file %>
  </div>

  <div class="actions">
    <%= f.submit %>
  </div>
<% end %>
