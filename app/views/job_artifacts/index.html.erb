<h1>Job Artifacts</h1>

<%= link_to "New Job Artifact", new_job_artifact_path, class: "btn btn-primary" %>

<table>
  <thead>
    <tr>
      <th>Name</th>
      <th>Job</th>
      <th>Type</th>
      <th>File</th>
      <th>Size</th>
      <th>Created At</th>
      <th colspan="3">Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @records.each do |record| %>
      <tr>
        <td><%= link_to record.name, job_artifact_path(record) %></td>
        <td><%= link_to record.job.name, job_path(record.job) if record.job %></td>
        <td><%= record.artifact_type.humanize %></td>
        <td><%= record.file.attached? ? record.file.filename : "N/A" %></td>
        <td><%= record.human_readable_size %></td>
        <td><%= record.created_at.strftime("%Y-%m-%d %H:%M") %></td>
        <td><%= link_to "Show", job_artifact_path(record) %></td>
        <td><%= link_to "Edit", edit_job_artifact_path(record) %></td>
        <td><%= link_to "Delete", job_artifact_path(record), data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } %></td>
      </tr>
    <% end %>
  </tbody>
</table>
