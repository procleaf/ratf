<h1>Notification #<%= @record.id %></h1>

<p>
  <strong>User:</strong> <%= @record.user&.username || "—" %>
</p>
<p>
  <strong>Message:</strong> <%= @record.message %>
</p>
<p>
  <strong>Type:</strong> <%= @record.notification_type %>
</p>
<p>
  <strong>Read At:</strong> <%= @record.read_at&.strftime("%Y-%m-%d %H:%M:%S") || "Unread" %>
</p>
<p>
  <strong>Created:</strong> <%= @record.created_at.strftime("%Y-%m-%d %H:%M:%S") %>
</p>

<% unless @record.read? %>
  <%= link_to "Mark as Read", mark_read_notification_path(@record), data: { turbo_method: :post } %> |
<% end %>
<%= link_to "Edit", edit_notification_path(@record) %> |
<%= link_to "Back to Notifications", notifications_path %>
