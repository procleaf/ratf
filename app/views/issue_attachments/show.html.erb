<h1>Attachment</h1>

<dl>
  <dt>Issue</dt>
  <dd><%= link_to @issue.title, issue_path(@issue) %></dd>
  <dt>Created</dt>
  <dd><%= l @record.created_at, format: :long %></dd>
</dl>

<% if @record.file.attached? %>
  <p><%= link_to "Download", rails_blob_path(@record.file, disposition: "attachment") %></p>
<% end %>

<%= link_to "Edit", edit_issue_issue_attachment_path(@issue, @record) %> |
<%= link_to "Back", issue_issue_attachments_path(@issue) %>
