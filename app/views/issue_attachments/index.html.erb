<h1>Attachments for <%= @issue.title %></h1>

<%= link_to "Add Attachment", new_issue_issue_attachment_path(@issue), class: "btn btn-primary" %>

<table>
  <thead>
    <tr>
      <th>Filename</th>
      <th>Created</th>
      <th colspan="3">Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @records.each do |attachment| %>
      <tr>
        <td><%= attachment.file.attached? ? attachment.file.filename : "No file" %></td>
        <td><%= l attachment.created_at, format: :short %></td>
        <td><%= link_to "Show", issue_issue_attachment_path(@issue, attachment) %></td>
        <td><%= link_to "Edit", edit_issue_issue_attachment_path(@issue, attachment) %></td>
        <td><%= link_to "Delete", issue_issue_attachment_path(@issue, attachment), data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= link_to "Back to Issue", issue_path(@issue) %>
