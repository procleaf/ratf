<%= form_with(model: @record, url: @record.persisted? ? issue_issue_attachment_path(@issue, @record) : issue_issue_attachments_path(@issue), local: true) do |f| %>
  <% if @record.errors.any? %>
    <div class="errors">
      <h2><%= pluralize(@record.errors.count, "error") %> prohibited this attachment:</h2>
      <ul>
        <% @record.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :file %>
    <%= f.file_field :file %>
  </div>

  <div>
    <%= f.submit %>
  </div>
<% end %>
