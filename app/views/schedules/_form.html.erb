<%= form_with(model: @record, local: true) do |f| %>
  <% if @record.errors.any? %>
    <div class="error-messages">
      <h2><%= pluralize(@record.errors.count, "error") %> prohibited this schedule from being saved:</h2>
      <ul>
        <% @record.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :name %>
    <%= f.text_field :name %>
  </div>

  <div class="field">
    <%= f.label :job_id, "Job" %>
    <%= f.collection_select :job_id, Job.order(:name), :id, :name, include_blank: true %>
  </div>

  <div class="field">
    <%= f.label :cron_expression %>
    <%= f.text_field :cron_expression, placeholder: "e.g. 0 2 * * * (daily at 2am)" %>
  </div>

  <div class="field">
    <%= f.label :description %>
    <%= f.text_area :description %>
  </div>

  <div class="field">
    <%= f.label :enabled %>
    <%= f.check_box :enabled %>
  </div>

  <div class="actions">
    <%= f.submit %>
  </div>
<% end %>
