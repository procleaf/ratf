<h1>Comments for <%= @issue.title %></h1>

<%= link_to "Add Comment", new_issue_issue_comment_path(@issue), class: "btn btn-primary" %>

<table>
  <thead>
    <tr>
      <th>User</th>
      <th>Content</th>
      <th>Created</th>
      <th colspan="3">Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @records.each do |comment| %>
      <tr>
        <td><%= comment.user&.username %></td>
        <td><%= truncate(comment.content, length: 80) %></td>
        <td><%= l comment.created_at, format: :short %></td>
        <td><%= link_to "Show", issue_issue_comment_path(@issue, comment) %></td>
        <td><%= link_to "Edit", edit_issue_issue_comment_path(@issue, comment) %></td>
        <td><%= link_to "Delete", issue_issue_comment_path(@issue, comment), data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= link_to "Back to Issue", issue_path(@issue) %>
