<h1>Test Suite Runs</h1>



<table>
  <thead>
    <tr>
      <th>ID</th>
      <th>Test Suite</th>
      <th>Status</th>
      <th>Total</th>
      <th>Passed</th>
      <th>Failed</th>
      <th>Skipped</th>
      <th>Errors</th>
      <th>Duration</th>
      <th>Created</th>
      <th colspan="3">Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @records.each do |record| %>
      <tr>
        <td><%= record.id %></td>
        <td><%= record.test_suite&.name %></td>
        <td><%= record.status %></td>
        <td><%= record.total_tests %></td>
        <td><%= record.passed_tests %></td>
        <td><%= record.failed_tests %></td>
        <td><%= record.skipped_tests %></td>
        <td><%= record.errored_tests %></td>
        <td><%= record.total_duration %></td>
        <td><%= record.created_at.strftime("%Y-%m-%d %H:%M") %></td>
        <td><%= link_to "Show", test_suite_run_path(record) %></td>
        <td></td>
        <td><%= link_to "Destroy", test_suite_run_path(record), data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } %></td>
      </tr>
    <% end %>
  </tbody>
</table>
