<%= form_with(model: @record, local: true) do |f| %>
  <% if @record.errors.any? %>
    <div class="error-messages">
      <h2><%= pluralize(@record.errors.count, "error") %> prohibited this job from being saved:</h2>
      <ul>
        <% @record.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :name %>
    <%= f.text_field :name %>
  </div>

  <div class="field">
    <%= f.label :description %>
    <%= f.text_area :description %>
  </div>

  <div class="field">
    <%= f.label :status %>
    <%= f.select :status, Job.statuses.keys.map { |k| [k.humanize, k] }, include_blank: false %>
  </div>

  <div class="field">
    <%= f.label :priority %>
    <%= f.select :priority, Job.priorities.keys.map { |k| [k.humanize, k] }, include_blank: false %>
  </div>

  <div class="field">
    <%= f.label :created_by_id, "Created By" %>
    <%= f.collection_select :created_by_id, User.order(:username), :id, :username, include_blank: true %>
  </div>

  <div class="field">
    <%= f.label :definition %>
    <%= f.text_area :definition, value: (@record.definition.is_a?(String) ? @record.definition : @record.definition.to_json), rows: 10 %>
  </div>

  <div class="field">
    <%= f.label :started_at %>
    <%= f.datetime_field :started_at %>
  </div>

  <div class="field">
    <%= f.label :completed_at %>
    <%= f.datetime_field :completed_at %>
  </div>

  <div class="actions">
    <%= f.submit %>
  </div>
<% end %>
